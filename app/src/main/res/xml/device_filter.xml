<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        vendor-id / product-id must be decimal integers. The XML parser will
        throw NumberFormatException on a 0x prefix and silently disable the
        filter, so always convert hex values before pasting here.
        0xF001 = 61441, 0xC901 = 51457 (placeholder until real card VID/PID
        is provided).
    -->
    <usb-device vendor-id="61441" product-id="51457" />
</resources>